# Template traité au démarrage par l'image nginx (envsubst) :
# seules les variables d'environnement DÉFINIES sont remplacées (BACKEND_URL, APP_VERSION),
# les variables nginx ($host, $status, ...) restent intactes.

map $status $log_level {
    ~^5     error;
    ~^4     warn;
    default info;
}

log_format json_logs escape=json
    '{"time":"$time_iso8601","level":"$log_level","service":"taskflow-frontend",'
    '"method":"$request_method","uri":"$request_uri","status":$status,'
    '"duration":$request_time,"bytes":$body_bytes_sent,"remote_addr":"$remote_addr",'
    '"user_agent":"$http_user_agent"}';

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    access_log /dev/stdout json_logs;

    # DNS du conteneur (Docker ou kube-dns), détecté au démarrage par l'image nginx.
    # Le nom du backend est re-résolu toutes les 10 s : si le backend change d'IP
    # (conteneur recréé), nginx suit sans redémarrage.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 2s;

    # Sonde de santé (liveness/readiness) : ne dépend pas du backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location = /version {
        access_log off;
        default_type application/json;
        return 200 '{"service":"frontend","version":"${APP_VERSION}"}';
    }

    # Reverse proxy vers l'API : l'adresse du backend est injectée par variable d'environnement.
    # La variable dans proxy_pass force la résolution DNS à l'exécution (via "resolver").
    location /api/ {
        set $backend_url ${BACKEND_URL};
        proxy_pass $backend_url;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout    30s;
        # En cas d'erreur de connexion sur un pod en cours d'arrêt, on retente.
        proxy_next_upstream error timeout http_502 http_503;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
